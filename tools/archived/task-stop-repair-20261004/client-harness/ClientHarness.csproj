<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);FakeBackend\**;FakeTool\**;Baseline\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../desktop-wpf/Services/BackendClient.cs" Link="BackendClient.cs" />
    <Compile Include="../../../desktop-wpf/Models/ConsoleSnapshot.cs" Link="ConsoleSnapshot.cs" />
    <Compile Include="../../../desktop-wpf/ViewModels/DesktopViewModel.cs" Link="DesktopViewModel.cs" />
  </ItemGroup>
</Project>
